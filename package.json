{
  "name": "vow",
  "version": "0.1.0",
  "description": "Confidential delegated procurement with supplier-bound STRK20 collection on Starknet.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enoch208/vow.git"
  },
  "homepage": "https://github.com/Enoch208/vow#readme",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "diagnostic": "npm run build:workbench && node scripts/serve-diagnostic.ts",
    "app": "npm run build:workbench && node scripts/serve-app.ts",
    "build": "tsc -p tsconfig.json",
    "build:site": "npm run build:workbench && NEXT_PUBLIC_SITE_URL=https://vow-mocha-two.vercel.app NEXT_PUBLIC_VOW_APP_URL=https://vow-mocha-two.vercel.app npm --prefix web run build && node scripts/build-static-site.ts",
    "test": "node --test packages/vow-sdk/test/*.test.ts",
    "evidence:verify": "node scripts/verify-evidence.mjs",
    "verify:vault": "node scripts/verify-live-vault.ts",
    "ci:clean": "sh scripts/clean-clone-ci.sh",
    "check": "npm run build:workbench && npm test",
    "build:workbench": "npm run build && sh scripts/cairo.sh build && node scripts/build-collection.ts",
    "deployment:preview": "node scripts/preview-deployment.ts",
    "supplier": "npm run build:workbench && node scripts/serve-supplier.ts"
  },
  "dependencies": {
    "@wallet-standard/app": "1.1.1",
    "starknet": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
